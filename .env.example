# ReconcileAI configuration template
# Copy to .env for your own machine. Keep .env out of Git.
# Credential and account-specific fields intentionally have no values.

# Application: local single-user runtime
DATABASE_URL=sqlite:///./storage/reconcile.db
STORAGE_PATH=./storage
WORKER_BACKEND=local
ORGANIZATION_ID=local
API_PORT=8010
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PDF extraction and upload limits
PARSER=docling
DOCLING_PIPELINE=standard
MAX_UPLOAD_MB=50
MAX_PAGES=500
ENABLE_VISION_FALLBACK=true
MAX_RECOVERY_PAGES=24

# Financial policy and human review
DEFAULT_PRICE_TOLERANCE_PERCENT=2
ROUNDING_TOLERANCE=0.02
ENABLE_HUMAN_REVIEW=true

# Generative AI: configure ONE provider in your private .env.
# OpenAI: fill OPENAI_API_KEY. The base URL is optional.
# If both providers are configured, OpenAI takes precedence.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Azure OpenAI: fill the resource endpoint, key and deployment name.
# Endpoint is the resource base URL, not a deployment-specific API URL.
INVOICE_AZURE_ENDPOINT=
INVOICE_AZURE_API_KEY=
INVOICE_AZURE_DEPLOYMENT=

# Dense retrieval: local embeddings need no provider API key.
# The encoder downloads on first use and is cached under storage/model-cache.
ENABLE_EMBEDDINGS=true
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_DUAL_AUGMENTATION=true

# Optional provider embeddings: used only with EMBEDDING_PROVIDER=provider.
# An Azure chat deployment does not serve embeddings; configure a separate one.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_EMBEDDING_DEPLOYMENT=

# Bounded execution; token budget is checked between model requests.
MAX_AGENT_TOOL_CALLS=24
MAX_AI_REQUESTS_PER_RUN=48
MAX_AI_TOKENS_PER_RUN=180000
AI_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=1800
LOCAL_WORKER_POLL_SECONDS=1

# Leave blank for the local portal. Optional API-level bearer guard only;
# the UI does not provide an account/login or token-entry workflow.
API_TOKEN=
