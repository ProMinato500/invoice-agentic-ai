# Local-first runtime (no Docker, Redis or PostgreSQL required)
DATABASE_URL=sqlite:///./storage/reconcile.db
STORAGE_PATH=./storage
WORKER_BACKEND=local
API_PORT=8010
FRONTEND_PORT=3000
PARSER=docling
DOCLING_PIPELINE=standard
MAX_UPLOAD_MB=50
MAX_PAGES=500
JOB_TIMEOUT_SECONDS=1800
DEFAULT_PRICE_TOLERANCE_PERCENT=2
ROUNDING_TOLERANCE=0.02
# Configure either OpenAI or the Azure deployment. Never put these in frontend env files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
INVOICE_AZURE_ENDPOINT=
INVOICE_AZURE_API_KEY=
INVOICE_AZURE_DEPLOYMENT=gpt-4o
ENABLE_EMBEDDINGS=true
ENABLE_DUAL_AUGMENTATION=true
ENABLE_VISION_FALLBACK=true
ENABLE_HUMAN_REVIEW=true
MAX_AGENT_TOOL_CALLS=12
API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local dense semantic retrieval (downloads model once).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_AI_REQUESTS_PER_RUN=48
MAX_AI_TOKENS_PER_RUN=180000
MAX_RECOVERY_PAGES=24
