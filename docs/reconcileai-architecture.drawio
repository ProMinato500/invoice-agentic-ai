<mxfile host="app.diagrams.net"><diagram id="reconcileai" name="ReconcileAI architecture"><mxGraphModel dx="1420" dy="850" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ReconcileAI | Evidence-backed document reconciliation" style="text;html=1;align=left;verticalAlign=middle;fontColor=#183862;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1250" height="45" as="geometry" /></mxCell><mxCell id="runtime" value="RUNTIME COMPONENTS" style="text;html=1;align=left;verticalAlign=middle;fontColor=#183862;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="500" height="35" as="geometry" /></mxCell><mxCell id="ui" value="Next.js + TypeScript&lt;br/&gt;&lt;b&gt;Browser portal&lt;/b&gt;&lt;br/&gt;PDF.js evidence viewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3fd;strokeColor=#98b6df;fontColor=#183862;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="220" height="115" as="geometry" /></mxCell><mxCell id="api" value="FastAPI&lt;br/&gt;&lt;b&gt;Application API&lt;/b&gt;&lt;br/&gt;Upload / results / reviews / reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3fd;strokeColor=#98b6df;fontColor=#183862;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="325" y="135" width="250" height="115" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;SQLite / WAL&lt;/b&gt;&lt;br/&gt;Queued runs, items, allocations,&lt;br/&gt;events, reviews and results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3fd;strokeColor=#98b6df;fontColor=#183862;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="645" y="135" width="265" height="115" as="geometry" /></mxCell><mxCell id="worker" value="&lt;b&gt;Durable worker + LangGraph&lt;/b&gt;&lt;br/&gt;OS lock / job claiming / budgets&lt;br/&gt;SQLite checkpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf